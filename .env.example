# Copy to .env (git-ignored). Only these variables are meaningful and safe.
# Auth is your Claude subscription (run `fortress login`). There are NO API keys here.

# NEVER set ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN. API keys bill per token; the server
# strips them from the environment on start, and /api/health reports apiKeyStripped if it had to.

PORT=4321                 # HTTP + WebSocket port
HOST=127.0.0.1            # keep loopback; do not expose the fortress to the network
FORTRESS_MOCK=0           # 1 = fake sessions, uses no Claude usage (same as `fortress mock`)
FORTRESS_DATA=            # optional: directory holding data/ and workspaces/ (default: repo root)
